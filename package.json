{
  "name": "cuboderubik",
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve -o",
    "start:public": "ng serve -o --host 0.0.0.0 --port 80",
    "start:prod": "mv dist/cuboderubik dist/dist && mv dist/dist/browser dist/dist/como-resolver-el-cubo-de-rubik && cd dist/dist/ && live-server . --open=como-resolver-el-cubo-de-rubik",
    "icons": "ng run cuboderubik:icons",
    "build": "ng build --base-href /como-resolver-el-cubo-de-rubik/",
    "deploy": "ng deploy"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@jaimemartinmartin15/jei-devkit-angular-shared": "^8.1.0",
    "@jaimemartinmartin15/svg-icons": "^1.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@jaimemartinmartin15/jei-devkit-angular-builders": "^5.2.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
